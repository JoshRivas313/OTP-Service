# Copiar a .env y rellenar con valores reales. .env esta en .gitignore.

MONGODB_URI=mongodb://localhost:27017/otp_service
OTP_HASH_SECRET=

# console (por defecto, no envia nada real) | twilio | infobip
SMS_PROVIDER=console

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=

# true solo para un demo publico con SMS_PROVIDER=console. Nunca combinar
# con twilio/infobip (la app falla al arrancar si se hace).
OTP_DEMO_MODE=false
