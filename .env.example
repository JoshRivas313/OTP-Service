# Variables de entorno que lee la aplicación.
#
# La aplicación NO carga .env por sí sola: define estas variables en el shell, en la configuración de ejecución del IDE
# o en el entorno de la plataforma. Docker Compose sí lee un archivo .env (ignorado por git) para sus variables.
#
# OBLIGATORIAS: OTP_HASH_SECRET y OTP_SECRET_ENCRYPTION_KEY. Sin ellas la aplicación no arranca, salvo con el perfil
# dev, que trae claves de ejemplo públicas y solo sirve para probar en local:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
# El resto es opcional: sin más, los códigos se guardan en memoria y se usa el proveedor "console".

# Almacenamiento: por defecto los códigos se guardan en memoria.
# Para usar MongoDB, activa el perfil "mongo" (se combina con coma: dev,mongo):
# SPRING_PROFILES_ACTIVE=mongo
# MONGODB_URI=mongodb://localhost:27017/otp_service   (solo se lee con el perfil mongo)
# Docker Compose pide además MONGO_PASSWORD:
# MONGO_PASSWORD=

# Tope de códigos guardados en memoria (se descartan los más antiguos al llegar)
OTP_MEMORY_MAX_ENTRIES=10000

# Clave del HMAC-SHA256 con el que se guarda el hash de cada código. Obligatoria: un valor largo y aleatorio.
# Generar con: openssl rand -hex 32
OTP_HASH_SECRET=

# Clave AES-256 que cifra los secretos de HOTP/TOTP. Generar con: openssl rand -base64 32
# Si se pierde o se cambia, los secretos guardados dejan de servir. Obligatoria.
OTP_SECRET_ENCRYPTION_KEY=

# Si es true, POST /otps devuelve el código en la respuesta (campo demoCode).
# No se puede combinar con SMS_PROVIDER=twilio ni infobip.
OTP_DEMO_MODE=false

# Proveedor de SMS: console (por defecto, escribe el mensaje en el log), twilio o infobip
SMS_PROVIDER=console

# Twilio (obligatorias solo si SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Infobip (obligatorias solo si SMS_PROVIDER=infobip)
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=

# Correo: console (por defecto, escribe el correo en el log) o brevo
EMAIL_PROVIDER=console
# Obligatorias solo si EMAIL_PROVIDER=brevo (la clave se guarda solo en el entorno, nunca en el repositorio)
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Un Solo Uso

# Límite de envíos por destino y por IP en una ventana (0 desactiva el límite)
OTP_RATE_LIMIT_PER_DESTINATION=5
OTP_RATE_LIMIT_PER_IP=20
OTP_RATE_LIMIT_WINDOW_SECONDS=600

# Límite de verificaciones por destino y por IP, en la misma ventana (0 desactiva el límite)
OTP_VERIFY_RATE_LIMIT_PER_DESTINATION=10
OTP_VERIFY_RATE_LIMIT_PER_IP=30

# Duración del bloqueo de HOTP/TOTP tras 3 fallos (no es la retención de datos)
OTP_LOCK_SECONDS=600

# Escribir el código en el log con los proveedores de consola. Apagado por defecto; el perfil dev lo enciende.
OTP_LOG_CODES=false

# Dejar que quien pide el código escriba el texto del mensaje. Apagado por defecto: el texto lo decide el servidor
# según el propósito. Un servidor público no debería activarlo (permitiría enviar texto libre a terceros).
# En modo demo y con el perfil dev está activo porque nada llega a nadie.
OTP_CUSTOM_MESSAGE_ENABLED=false

# Conexiones de Twilio por IP en la ventana de arriba (0 desactiva el límite)
OTP_CONNECT_RATE_LIMIT_PER_IP=10

# Cuánto se conserva la credencial HOTP/TOTP de un destino sin actividad (30 días). Con MongoDB la borra un índice TTL.
OTP_CREDENTIAL_RETENTION_SECONDS=2592000

# Tope global de envíos por día, para no agotar la cuota del proveedor. 0 lo desactiva.
# Con el plan gratuito de Brevo (300 correos al día) conviene dejar margen: 250
OTP_DAILY_SEND_LIMIT=0

# Proxies de confianza: solo de ellos se lee X-Forwarded-For (por defecto, redes privadas y localhost)
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}

# Al publicar en internet
# Si es true, la cookie de sesión solo viaja por HTTPS
SESSION_COOKIE_SECURE=false
# Si es false, se deshabilitan POST /otps y POST /otps/verify
OTP_LOCAL_API_ENABLED=true

# Si es false, se deshabilitan Swagger UI y /v3/api-docs (la imagen Docker lo trae en false)
SWAGGER_ENABLED=true

# Puerto HTTP (por defecto 8080; las plataformas como Render lo definen solas)
PORT=8080
